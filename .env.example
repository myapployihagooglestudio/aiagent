# GEMINI_API_KEY: Required for Gemini AI reasoning, speech transcription, video understanding, and TTS.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_PRIMARY_MODEL: Primary conversational/multimodal model (official ID: gemini-3.5-flash-lite).
GEMINI_PRIMARY_MODEL="gemini-3.5-flash-lite"

# GEMINI_FALLBACK_MODEL: Optional verified compatible fallback model when primary encounters 429/503 (leave blank to disable).
# Never uses deprecated/old models automatically without verifying availability and quota.
GEMINI_FALLBACK_MODEL=""

# GEMINI_MAX_CONCURRENCY: Maximum concurrent Gemini requests permitted by the app (initial default: 2).
GEMINI_MAX_CONCURRENCY="2"

# GEMINI_RPM_LIMIT: Application-level RPM safety limit (initial default: 10), NOT a claim about Google's official quota.
GEMINI_RPM_LIMIT="10"

# TELEGRAM_BOT_TOKEN: Dedicated OMNIA AI bot token from @BotFather (with Business Mode enabled).
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Random secret string (1-256 chars, [A-Za-z0-9_-]) verified via X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_OWNER_USER_ID: Required immutable numeric Telegram User ID locking all owner commands & approvals.
TELEGRAM_OWNER_USER_ID=""

# APP_URL: Public HTTPS base URL of your Cloud Run deployment (e.g. https://omnia-bot-xyz.a.run.app).
APP_URL="MY_APP_URL"

# Database: Configured via Google Cloud Firestore (firebase-applet-config.json) + Google Cloud ADC.
# No manual DATABASE_URL is required.
# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON (or base64 JSON) service account for basic-petal-001dl when runtime ADC lacks IAM permissions.
FIREBASE_SERVICE_ACCOUNT_JSON=""
